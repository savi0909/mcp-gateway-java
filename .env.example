# Reference only: Spring Boot does not automatically load .env files.
# Set these in the shell or your IDE. Never commit real bearer tokens.
GATEWAY_CATALOG_LOCATION=classpath:catalog/worker-catalog.json
WORKER_COORDINATOR_BASE_URL=http://127.0.0.1:9090
WORKER_COORDINATOR_BEARER_TOKEN=
# Opt-in payments profile uses the existing separate worker sample API.
PAYMENT_API_BASE_URL=http://127.0.0.1:9091
# Combined worker-payments profile also supports a separate private payment token.
PAYMENT_API_BEARER_TOKEN=
# Docker Compose reads these from config/local/coordinator.env, not automatically from this file.
COORDINATOR_PROJECT_DIR=D:/java-projects/distributed-coordinator
COORDINATOR_HTTP_PORT=9090
PAYMENT_HTTP_PORT=9091
COORDINATOR_POSTGRES_PASSWORD=
