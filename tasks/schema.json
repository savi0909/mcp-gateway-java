{
  "title": "Engineering task backlog v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "pilot_authorization": {
      "type": [
        "string",
        "null"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Z][A-Z0-9]*-[0-9]{2,3}"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "in_progress",
              "validating",
              "completed",
              "blocked",
              "needs_review"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "spec_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "maven-verify"
              ]
            },
            "minItems": 1
          },
          "requires_human_approval": {
            "type": "boolean"
          },
          "review_required": {
            "type": "boolean",
            "const": true
          },
          "model_role": {
            "type": "string",
            "enum": [
              "implement",
              "complex_implement"
            ]
          },
          "phase": {
            "type": "integer",
            "minimum": 2,
            "maximum": 3
          },
          "base_commit": {
            "type": "string",
            "pattern": "[a-f0-9]{40}"
          },
          "approval": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "scope_sha256": {
                "type": "string",
                "pattern": "[a-f0-9]{64}"
              },
              "approved_by": {
                "type": "string",
                "const": "owner"
              }
            },
            "required": [
              "reference",
              "scope_sha256",
              "approved_by"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "block_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "risk",
          "dependencies",
          "spec_refs",
          "scope",
          "acceptance_criteria",
          "tests",
          "requires_human_approval",
          "review_required",
          "model_role",
          "phase",
          "base_commit",
          "approval",
          "attempts",
          "run_id",
          "content_commit",
          "evidence",
          "block_reason"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "pilot_authorization",
    "tasks"
  ]
}
